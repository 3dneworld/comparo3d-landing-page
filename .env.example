# Comparo3D Frontend — Variables de entorno
# Copiar como .env para desarrollo local

# URL del backend API
# Producción (default): https://api.3dneworld.com
# Desarrollo local:
VITE_API_URL=http://localhost:5001

# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX)
# En dev local podés dejarlo vacío (gtag carga pero no trackea).
# En .env.production debe estar el ID real de la propiedad GA4 de comparo3d.com.ar.
VITE_GA_MEASUREMENT_ID=
